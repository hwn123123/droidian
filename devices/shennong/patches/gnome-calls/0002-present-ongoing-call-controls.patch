--- a/src/calls-application.c
+++ b/src/calls-application.c
@@ -697,6 +697,17 @@
 
   start_proper (self);
 
+  /* Returning to the app during a call must reveal its controls, rather
+   * than presenting another dial pad over the still-active modem call. */
+  if (!self->uri) {
+    g_autoptr (GList) calls = calls_manager_get_calls (calls_manager_get_default ());
+    for (GList *item = calls; item; item = item->next) {
+      if (cui_call_get_state (CUI_CALL (item->data)) != CUI_CALL_STATE_DISCONNECTED) {
+        gtk_window_present (GTK_WINDOW (self->call_window));
+        return;
+      }
+    }
+  }
   gtk_window_present (GTK_WINDOW (self->main_window));
 
   if (self->uri) {
--- a/src/calls-call-window.c
+++ b/src/calls-call-window.c
@@ -150,8 +150,9 @@
 
   display = cui_call_display_new (CUI_CALL (ui_call_data));
   item = calls_call_selector_item_new (display);
-  gtk_stack_add_named (self->call_stack, GTK_WIDGET (display),
-                       cui_call_get_id (call));
+  /* A telephone number is not unique when a call is held or two SIMs
+   * dial the same service. This stack uses widget identity, not names. */
+  gtk_stack_add_child (self->call_stack, GTK_WIDGET (display));
 
   g_list_store_append (self->calls, item);
 
