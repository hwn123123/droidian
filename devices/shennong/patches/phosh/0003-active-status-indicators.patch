   g_return_if_fail (NM_IS_CLIENT (nmclient));

   state = nm_client_get_connectivity (nmclient);
+  /* An unknown probe or an intentionally disconnected radio is not a fault. */
+  show_warning = nm_client_get_state (nmclient) >= NM_STATE_CONNECTED_LOCAL &&
+    (state == NM_CONNECTIVITY_NONE || state == NM_CONNECTIVITY_LIMITED ||
+     state == NM_CONNECTIVITY_PORTAL);
+  if (self->show_warning != show_warning) {
+    self->show_warning = show_warning;
