+    g_value_set_boolean (value, self->connected);
     break;
   case PROP_PRESENT:
     g_value_set_boolean (value, self->present);
@@ -91,6 +96,20 @@
 }

 static void
+update_connected (PhoshWifiInfo *self)
+{
+  gboolean connected = phosh_wifi_manager_get_enabled (self->wifi) &&
+    phosh_wifi_manager_get_state (self->wifi) == NM_ACTIVE_CONNECTION_STATE_ACTIVATED;
+
+  if (self->connected == connected)
+    return;
+
+  self->connected = connected;
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_CONNECTED]);
+}
+
+
+static void
 on_wifi_enabled (PhoshWifiInfo *self, GParamSpec *pspec, PhoshWifiManager *wifi)
 {
   gboolean enabled;
@@ -99,6 +118,7 @@
   g_return_if_fail (PHOSH_IS_WIFI_INFO (self));
   g_return_if_fail (PHOSH_IS_WIFI_MANAGER (wifi));

+  update_connected (self);
   enabled = phosh_wifi_manager_get_enabled (wifi);
   if (self->enabled == enabled)
     return;
@@ -150,6 +170,9 @@
     g_warning ("Failed to get Wi-Fi manager");
     return;
   }
+
+  g_signal_connect_object (self->wifi, "notify::state",
