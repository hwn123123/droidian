+set_home_drop_target (PhoshAppGridButton *self, GtkWidget *target)
 {
-  context_menu (self, NULL);
+  PhoshAppGridButtonPrivate *priv = phosh_app_grid_button_get_instance_private (self);
+  if (target == GTK_WIDGET (self))
+    target = NULL;
+  if (priv->home_drop_target == target)
