+static void
+update_deck_swipe_directions (HdyDeck       *deck,
+                              GParamSpec    *pspec,
+                              PhoshAppGrid  *self)
+{
+  PhoshAppGridPrivate *priv;
+  GtkWidget *visible;
+  GtkWidget *home;
+  gboolean can_swipe_back = FALSE;
+  gboolean can_swipe_forward = FALSE;
+  gboolean show_home_dock = FALSE;
+
+  (void) pspec;
+  g_return_if_fail (PHOSH_IS_APP_GRID (self));
+
+  priv = phosh_app_grid_get_instance_private (self);
+  visible = hdy_deck_get_visible_child (deck);
+  home = hdy_deck_get_child_by_name (deck, "phone_home");
+
+  if (visible == home) {
+    show_home_dock = TRUE;
+    can_swipe_forward = priv->home_app_pages && priv->home_app_pages->len > 0;
+  } else if (priv->home_app_pages) {
+    for (guint i = 0; i < priv->home_app_pages->len; i++) {
+      if (g_ptr_array_index (priv->home_app_pages, i) != visible)
+        continue;
+
+      show_home_dock = TRUE;
+      can_swipe_back = TRUE;
+      can_swipe_forward = i + 1 < priv->home_app_pages->len;
+      break;
+    }
+  }
+
+  if (priv->home_dock)
+    gtk_widget_set_visible (priv->home_dock, show_home_dock);
+
+  /* Left swipes advance through phone-style app pages; right swipes return. */
+  hdy_deck_set_can_swipe_back (deck, can_swipe_back);
+  hdy_deck_set_can_swipe_forward (deck, can_swipe_forward);
+}
