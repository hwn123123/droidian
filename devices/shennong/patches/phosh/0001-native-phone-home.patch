+  if (priv->home_drop_target)
+    gtk_style_context_remove_class (gtk_widget_get_style_context (priv->home_drop_target),
+                                     "home-drop-target");
+  g_set_object (&priv->home_drop_target, target);
+  if (target)
+    gtk_style_context_add_class (gtk_widget_get_style_context (target), "home-drop-target");
 }
 
 
+static void
+on_long_pressed (GtkWidget *widget, double x, double y, GtkGesture *gesture)
+{
+  PhoshAppGridButton *self = PHOSH_APP_GRID_BUTTON (widget);
+  PhoshAppGridButtonPrivate *priv = phosh_app_grid_button_get_instance_private (self);
+  priv->home_drag_active = TRUE;
+  gtk_gesture_set_state (gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+  gtk_style_context_add_class (gtk_widget_get_style_context (widget), "home-dragging");
+}
+
+
+static void
+on_home_drag_update (PhoshAppGridButton *self, double dx, double dy, GtkGestureDrag *gesture)
+{
+  PhoshAppGridButtonPrivate *priv = phosh_app_grid_button_get_instance_private (self);
+  GtkWidget *top = gtk_widget_get_toplevel (GTK_WIDGET (self));
+  double start_x, start_y;
+  int x, y;
+  if (!priv->home_drag_active || !gtk_gesture_drag_get_start_point (gesture, &start_x, &start_y))
+    return;
+  if (gtk_widget_translate_coordinates (GTK_WIDGET (self), top,
+                                         start_x + dx, start_y + dy, &x, &y))
+    set_home_drop_target (self, home_button_at (top, top, x, y));
+}
+
+
+static void
+on_home_drag_end (PhoshAppGridButton *self, double dx, double dy, GtkGestureDrag *gesture)
+{
+  PhoshAppGridButtonPrivate *priv = phosh_app_grid_button_get_instance_private (self);
+  g_autoptr (GtkWidget) target = NULL;
+  g_autofree char *source = NULL;
+  if (!priv->home_drag_active)
+    return;
+  on_home_drag_update (self, dx, dy, gesture);
+  priv->home_drag_active = FALSE;
+  gtk_style_context_remove_class (gtk_widget_get_style_context (GTK_WIDGET (self)), "home-dragging");
+  if (priv->home_drop_target)
+    target = g_object_ref (priv->home_drop_target);
+  set_home_drop_target (self, NULL);
+  source = g_strdup (g_app_info_get_id (priv->info));
+  if (target)
+    g_signal_emit (target, signals[APP_MOVED], 0, source);
+  else if (dx * dx + dy * dy < 64)
+    context_menu (GTK_WIDGET (self), NULL);
+}
+
+
+static void
+on_home_drag_cancel (PhoshAppGridButton *self, GdkEventSequence *sequence, GtkGesture *gesture)
+{
+  PhoshAppGridButtonPrivate *priv = phosh_app_grid_button_get_instance_private (self);
+  priv->home_drag_active = FALSE;
+  set_home_drop_target (self, NULL);
+  gtk_style_context_remove_class (gtk_widget_get_style_context (GTK_WIDGET (self)), "home-dragging");
+}
