+/* Reorder inside the shell, without a compositor-wide data-device drag. */
+static GtkWidget *
+home_button_at (GtkWidget *widget, GtkWidget *toplevel, int x, int y)
+{
+  int local_x, local_y;
+  if (!gtk_widget_get_mapped (widget) ||
+      !gtk_widget_translate_coordinates (toplevel, widget, x, y, &local_x, &local_y) ||
+      local_x < 0 || local_y < 0 ||
+      local_x >= gtk_widget_get_allocated_width (widget) ||
+      local_y >= gtk_widget_get_allocated_height (widget))
+    return NULL;
+  if (PHOSH_IS_APP_GRID_BUTTON (widget))
+    return widget;
+  if (GTK_IS_CONTAINER (widget)) {
+    g_autoptr (GList) children = gtk_container_get_children (GTK_CONTAINER (widget));
+    for (GList *l = children; l; l = l->next) {
+      GtkWidget *found = home_button_at (l->data, toplevel, x, y);
+      if (found)
+        return found;
+    }
+  }
+  return NULL;
+}
