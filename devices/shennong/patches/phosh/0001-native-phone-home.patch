+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled), GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_box_pack_start (GTK_BOX (page), scrolled, TRUE, TRUE, 0);
+
+  gtk_widget_set_visible (grid, TRUE);
+  gtk_widget_set_hexpand (grid, TRUE);
+  gtk_widget_set_halign (grid, GTK_ALIGN_FILL);
+  gtk_widget_set_valign (grid, GTK_ALIGN_START);
+  gtk_widget_set_margin_start (grid, 8);
+  gtk_widget_set_margin_end (grid, 8);
+  gtk_widget_set_margin_top (grid, 20);
+  gtk_widget_set_margin_bottom (grid, 20);
+  gtk_grid_set_column_homogeneous (GTK_GRID (grid), TRUE);
+  gtk_grid_set_row_homogeneous (GTK_GRID (grid), TRUE);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 8);
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 12);
+  gtk_container_add (GTK_CONTAINER (scrolled), grid);
+
+  /* Keep four columns and complete the final row with invisible placeholders. */
+  for (guint page_index = 0; page_index < n_cells; page_index++) {
+    guint app_index = start + page_index;
+    GtkWidget *button = NULL;
+
+    if (app_index < end) {
+      GObject *app = G_OBJECT (g_list_model_get_item (apps, app_index));
+      if (app) {
+        button = create_launcher (app, self);
+        g_object_unref (app);
+      }
+    }
+
+    if (button == NULL) {
+      button = gtk_label_new (NULL);
+      gtk_widget_set_visible (button, TRUE);
+      gtk_widget_set_can_focus (button, FALSE);
+      gtk_widget_set_sensitive (button, FALSE);
+      gtk_widget_set_hexpand (button, TRUE);
+      gtk_widget_set_vexpand (button, TRUE);
+      gtk_widget_set_opacity (button, 0.0);
+    }
+
+    gtk_grid_attach (GTK_GRID (grid), button, page_index % 4, page_index / 4, 1, 1);
+  }
+
+  gtk_widget_set_visible (footer, TRUE);
+  gtk_widget_set_visible (indicator, TRUE);
+  gtk_widget_set_halign (indicator, GTK_ALIGN_CENTER);
+  gtk_widget_set_margin_top (indicator, 6);
+  gtk_widget_set_margin_bottom (indicator, 6);
+  gtk_label_set_text (GTK_LABEL (indicator), page_text);
+  gtk_style_context_add_class (gtk_widget_get_style_context (indicator), "phosh-phone-home-page-indicator");
+  gtk_box_pack_start (GTK_BOX (footer), indicator, FALSE, FALSE, 0);
+  gtk_box_pack_end (GTK_BOX (page), footer, FALSE, FALSE, 0);
+
+  return page;
+}
+
+static void
+rebuild_home_app_pages (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  HdyDeck *deck = HDY_DECK (priv->deck);
+  GtkWidget *home = hdy_deck_get_child_by_name (deck, "phone_home");
+  GtkWidget *visible = hdy_deck_get_visible_child (deck);
+  guint n_apps = g_list_model_get_n_items (G_LIST_MODEL (priv->model));
+  guint n_pages = n_apps > 0 ? 1 : 0;
+  GtkWidget *after = home;
+  gboolean was_apps = priv->home_app_pages &&
+    g_ptr_array_find (priv->home_app_pages, visible, NULL);
+  guint duration = hdy_deck_get_transition_duration (deck);
+
+  hdy_deck_set_transition_duration (deck, 0);
+
+  for (guint i = 0; i < (priv->home_app_pages ? priv->home_app_pages->len : 0); i++) {
+    GtkWidget *page = g_ptr_array_index (priv->home_app_pages, i);
+    if (visible == page)
+      hdy_deck_set_visible_child (deck, home);
+    gtk_container_remove (GTK_CONTAINER (deck), page);
+  }
+  if (priv->home_app_pages)
+    g_ptr_array_set_size (priv->home_app_pages, 0);
+  else
+    priv->home_app_pages = g_ptr_array_new ();
+
+  for (guint i = 0; i < n_pages; i++) {
+    GtkWidget *page = create_home_app_page (self, i, n_pages, G_LIST_MODEL (priv->model));
+    hdy_deck_insert_child_after (deck, page, after);
+    g_ptr_array_add (priv->home_app_pages, page);
+    after = page;
+  }
+
+  if (priv->home_page_indicator) {
+    g_autofree char *page_text = g_strdup (n_pages > 0 ? "●  ○" : "●");
+    gtk_label_set_text (GTK_LABEL (priv->home_page_indicator), page_text);
+  }
+  if (was_apps && n_pages)
+    hdy_deck_set_visible_child (deck, g_ptr_array_index (priv->home_app_pages, 0));
+  hdy_deck_set_transition_duration (deck, duration);
+  update_deck_swipe_directions (deck, NULL, self);
+}
