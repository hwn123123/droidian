+typedef struct {
+  PhoshAppGrid *grid;
+  GAppInfo *target;
+  char *source;
+} HomeAppMove;
+
+
+static void
+home_app_move_free (gpointer data)
+{
+  HomeAppMove *move = data;
+  g_object_unref (move->grid);
+  g_object_unref (move->target);
+  g_free (move->source);
+  g_free (move);
+}
+
+
+static gboolean
+finish_home_app_moved (gpointer data)
+{
+  HomeAppMove *move = data;
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (move->grid);
+  GAppInfo *target = move->target;
+  const char *source = move->source;
+  const char *target_id = g_app_info_get_id (target);
+  gboolean favorite = phosh_favorite_list_model_app_is_favorite (NULL, target);
+  g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+  g_auto (GStrv) ids = NULL;
+  gboolean inserted = FALSE;
+
+  if (favorite) {
+    ids = g_settings_get_strv (priv->settings, "favorites");
+  } else {
+    g_autoptr (GStrvBuilder) current = g_strv_builder_new ();
+    for (guint i = 0; i < g_list_model_get_n_items (G_LIST_MODEL (priv->model)); i++) {
+      g_autoptr (GAppInfo) app = g_list_model_get_item (G_LIST_MODEL (priv->model), i);
+      g_strv_builder_add (current, g_app_info_get_id (app));
+    }
+    ids = g_strv_builder_end (current);
+  }
+  for (guint i = 0; ids[i]; i++) {
+    if (g_strcmp0 (ids[i], source) == 0)
+      continue;
+    if (g_strcmp0 (ids[i], target_id) == 0) {
+      g_strv_builder_add (builder, source);
+      inserted = TRUE;
+    }
+    g_strv_builder_add (builder, ids[i]);
+  }
+  if (!inserted)
+    g_strv_builder_add (builder, source);
+  {
+    g_auto (GStrv) result = g_strv_builder_end (builder);
+    if (favorite)
+      g_settings_set_strv (priv->settings, "favorites", (const char * const *) result);
+    else {
+      g_autoptr (GAppInfo) moved = G_APP_INFO (g_desktop_app_info_new (source));
+      if (moved && phosh_favorite_list_model_app_is_favorite (NULL, moved))
+        phosh_favorite_list_model_remove_app (NULL, moved);
+      g_settings_set_strv (priv->home_settings, "app-order", (const char * const *) result);
+    }
+  }
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+home_app_moved (PhoshAppGridButton *button, const char *source, PhoshAppGrid *self)
+{
+  HomeAppMove *move = g_new0 (HomeAppMove, 1);
+  move->grid = g_object_ref (self);
+  move->target = g_object_ref (phosh_app_grid_button_get_app_info (button));
+  move->source = g_strdup (source);
+  /* Rebuilding launchers during touch release invalidates GTK's event target. */
+  g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, finish_home_app_moved,
+                   move, home_app_move_free);
+}
