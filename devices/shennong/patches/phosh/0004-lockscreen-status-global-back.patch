+phosh-lockscreen-status .network-strength block.filled { background: #4bd6bc; }
+phosh-lockscreen-status .cpu-tile block.filled { background: #6ab8ff; }
+phosh-lockscreen-status .temperature-tile block.filled { background: #ffbc7c; }
+phosh-lockscreen-status .memory-tile block.filled { background: #4bd6bc; }
+phosh-lockscreen-status .battery-tile block.filled { background: #bca5ff; }
+phosh-lockscreen-status .cpu-tile .status-number { color: #93caff; }
+phosh-lockscreen-status .temperature-tile .status-number { color: #ffd1a7; }
+phosh-lockscreen-status .memory-tile .status-number { color: #83e5d3; }
+phosh-lockscreen-status .battery-tile .status-number { color: #d3c4ff; }
+
+phosh-lockscreen-status levelbar block.empty { background: rgba(185,208,230,.13); }
