diff --git a/src/lockscreen-status.c b/src/lockscreen-status.c
new file mode 100644
index 0000000..2b2e012
--- /dev/null
+++ b/src/lockscreen-status.c
@@ -0,0 +1,676 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#define G_LOG_DOMAIN "phosh-lockscreen-status"
+
+#include "phosh-config.h"
+#include "lockscreen-status.h"
+#include "shell-priv.h"
+#include "wwan/wwan-manager.h"
+#include "wwan/phosh-wwan-ofono.h"
+#include "wwan/phosh-wwan-mm.h"
+
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+  guint64 total, idle;
+  double memory, temperature;
+  gboolean cpu_valid, memory_valid, temperature_valid, traffic_valid;
+  guint64 rx, tx;
+  gint64 time;
+} Sample;
+
+typedef struct {
+  GtkWidget *value, *bar;
+} Metric;
+
+struct _PhoshLockscreenStatus {
+  GtkBox parent;
+  Metric cpu, temperature, memory, battery_metric;
+  GtkWidget *carrier, *technology, *signal, *signal_bar, *registration, *wifi_label;
+  GtkWidget *download, *upload, *detail_values[4];
+  PhoshBatteryManager *battery;
+  NMActiveConnection *data_connection;
+  GDBusProxy *registration_proxy;
+  GVariant *registration_details;
+  GCancellable *cancel;
+  char *registration_path, *actual_apn;
+  gboolean registration_pending, properties_pending, contexts_pending;
+  char *data_iface;
+  guint64 previous_rx, previous_tx;
+  gint64 previous_time;
+  gboolean have_traffic;
+  PhoshWWan *wwan;
+  PhoshWifiManager *wifi;
+  GSettings *settings;
+  guint timer;
+  gboolean active, pending, have_previous;
+  guint64 previous_total, previous_idle;
+};
+
+G_DEFINE_TYPE (PhoshLockscreenStatus, phosh_lockscreen_status, GTK_TYPE_BOX)
+
+/* Only local kernel counters are sampled. No subprocesses, modem polling,
+ * connectivity probes, privileged access or wake locks are needed. */
+static void
+collect_sample (GTask *task, gpointer source, gpointer task_data, GCancellable *cancellable)
+{
+  Sample *sample = g_new0 (Sample, 1);
+  g_autofree char *stat = NULL, *meminfo = NULL;
+  g_autoptr (GDir) thermal = NULL;
+  guint64 user, nice, system, idle, wait, irq, softirq, steal;
+  guint64 mem_total = 0, available = 0;
+  gboolean have_available = FALSE;
+  const char *name;
+
+  if (g_file_get_contents ("/proc/stat", &stat, NULL, NULL) &&
+      sscanf (stat, "cpu %" G_GUINT64_FORMAT " %" G_GUINT64_FORMAT
+              " %" G_GUINT64_FORMAT " %" G_GUINT64_FORMAT " %" G_GUINT64_FORMAT
+              " %" G_GUINT64_FORMAT " %" G_GUINT64_FORMAT " %" G_GUINT64_FORMAT,
+              &user, &nice, &system, &idle, &wait, &irq, &softirq, &steal) == 8) {
+    sample->total = user + nice + system + idle + wait + irq + softirq + steal;
+    sample->idle = idle + wait;
+    sample->cpu_valid = TRUE;
+  }
+  if (g_file_get_contents ("/proc/meminfo", &meminfo, NULL, NULL)) {
+    g_auto (GStrv) lines = g_strsplit (meminfo, "\n", -1);
+    for (guint i = 0; lines[i]; i++) {
+      if (g_str_has_prefix (lines[i], "MemTotal:"))
+        mem_total = g_ascii_strtoull (lines[i] + strlen ("MemTotal:"), NULL, 10);
+      if (g_str_has_prefix (lines[i], "MemAvailable:")) {
+        available = g_ascii_strtoull (lines[i] + strlen ("MemAvailable:"), NULL, 10);
+        have_available = TRUE;
+      }
+    }
+    if (mem_total && have_available) {
+      sample->memory = 100.0 * (mem_total - MIN (mem_total, available)) / mem_total;
+      sample->memory_valid = TRUE;
+    }
+  }
+  thermal = g_dir_open ("/sys/class/thermal", 0, NULL);
+  while (thermal && (name = g_dir_read_name (thermal))) {
+    g_autofree char *type_path = NULL, *temp_path = NULL, *type = NULL, *temp = NULL;
+    char *end;
+    gint64 value;
+
+    if (!g_str_has_prefix (name, "thermal_zone"))
+      continue;
+    type_path = g_build_filename ("/sys/class/thermal", name, "type", NULL);
+    if (!g_file_get_contents (type_path, &type, NULL, NULL) || !g_str_has_prefix (type, "cpu"))
+      continue;
+    temp_path = g_build_filename ("/sys/class/thermal", name, "temp", NULL);
+    if (!g_file_get_contents (temp_path, &temp, NULL, NULL))
+      continue;
+    value = g_ascii_strtoll (temp, &end, 10);
+    if (end == temp || value < -20000 || value > 150000)
+      continue;
+    /* Report the hottest CPU sensor, never the battery or a dummy zone. */
+    if (!sample->temperature_valid || value / 1000.0 > sample->temperature)
+      sample->temperature = value / 1000.0;
+    sample->temperature_valid = TRUE;
+  }
+  if (task_data && *(char *) task_data) {
+    g_autofree char *rx_path = g_build_filename ("/sys/class/net", task_data, "statistics/rx_bytes", NULL);
+    g_autofree char *tx_path = g_build_filename ("/sys/class/net", task_data, "statistics/tx_bytes", NULL);
+    g_autofree char *rx = NULL, *tx = NULL;
+    if (g_file_get_contents (rx_path, &rx, NULL, NULL) &&
+        g_file_get_contents (tx_path, &tx, NULL, NULL)) {
+      sample->rx = g_ascii_strtoull (rx, NULL, 10);
+      sample->tx = g_ascii_strtoull (tx, NULL, 10);
+      sample->traffic_valid = TRUE;
+    }
+  }
+  sample->time = g_get_monotonic_time ();
+  g_task_return_pointer (task, sample, g_free);
+}
+
+static void
+set_metric (Metric *metric, const char *text, double value, gboolean known)
+{
+  gtk_label_set_text (GTK_LABEL (metric->value), text);
+  gtk_level_bar_set_value (GTK_LEVEL_BAR (metric->bar), known ? CLAMP (value / 100, 0, 1) : 0);
+  gtk_widget_set_opacity (metric->bar, known ? 1 : .25);
+}
+
+static char *
+format_rate (double bytes)
+{
+  if (bytes >= 1024 * 1024)
+    return g_strdup_printf ("%.1f MB/s", bytes / (1024 * 1024));
+  if (bytes >= 1024)
+    return g_strdup_printf ("%.1f KB/s", bytes / 1024);
+  return g_strdup_printf ("%.0f B/s", bytes);
+}
+
+static void
+sample_ready (GObject *source, GAsyncResult *result, gpointer unused)
+{
+  PhoshLockscreenStatus *self = PHOSH_LOCKSCREEN_STATUS (source);
+  g_autofree Sample *sample = g_task_propagate_pointer (G_TASK (result), NULL);
+  g_autofree char *cpu = NULL, *memory = NULL, *temperature = NULL;
+  double busy = 0;
+  gboolean cpu_known;
+
+  self->pending = FALSE;
+  if (!self->active || !sample)
+    return;
+  cpu_known = sample->cpu_valid && self->have_previous &&
+    sample->total > self->previous_total && sample->idle >= self->previous_idle;
+  if (cpu_known)
+    busy = CLAMP (100.0 * (1.0 - (double) (sample->idle - self->previous_idle) /
+                                      (sample->total - self->previous_total)), 0, 100);
+  cpu = cpu_known ? g_strdup_printf ("%.0f%%", busy) : g_strdup ("—");
+  self->previous_total = sample->total;
+  self->previous_idle = sample->idle;
+  self->have_previous = sample->cpu_valid;
+  memory = sample->memory_valid ? g_strdup_printf ("%.0f%%", sample->memory) : g_strdup ("—");
+  temperature = sample->temperature_valid ? g_strdup_printf ("%.0f°", sample->temperature) : g_strdup ("—");
+  set_metric (&self->cpu, cpu, busy, cpu_known);
+  set_metric (&self->memory, memory, sample->memory, sample->memory_valid);
+  set_metric (&self->temperature, temperature, sample->temperature, sample->temperature_valid);
+  if (!g_strcmp0 (g_task_get_task_data (G_TASK (result)), self->data_iface) && sample->traffic_valid) {
+    if (self->have_traffic && sample->time > self->previous_time &&
+        sample->rx >= self->previous_rx && sample->tx >= self->previous_tx) {
+      double seconds = (sample->time - self->previous_time) / 1000000.0;
+      g_autofree char *down = format_rate ((sample->rx - self->previous_rx) / seconds);
+      g_autofree char *up = format_rate ((sample->tx - self->previous_tx) / seconds);
+      gtk_label_set_text (GTK_LABEL (self->download), down);
+      gtk_label_set_text (GTK_LABEL (self->upload), up);
+    }
+    self->previous_rx = sample->rx;
+    self->previous_tx = sample->tx;
+    self->previous_time = sample->time;
+    self->have_traffic = TRUE;
+  }
+  g_debug ("CPU %s, temperature %.1f°C, memory %s", cpu, sample->temperature, memory);
+}
+
+static void
+update_battery (PhoshLockscreenStatus *self)
+{
+  gboolean present = FALSE;
+  guint percent = 0;
+  g_autofree char *text = NULL;
+
+  if (!self->active || !self->battery)
+    return;
+  g_object_get (self->battery, "present", &present, "percent", &percent, NULL);
+  text = present ? g_strdup_printf ("%u%%", percent) : g_strdup ("—");
+  set_metric (&self->battery_metric, text, percent, present);
+}
+
+static const char *
+registration_name (const char *status)
+{
+  if (!g_strcmp0 (status, "registered")) return "已注册";
+  if (!g_strcmp0 (status, "roaming")) return "漫游";
+  if (!g_strcmp0 (status, "searching")) return "搜索网络";
+  if (!g_strcmp0 (status, "denied")) return "注册被拒绝";
+  if (!g_strcmp0 (status, "unregistered")) return "未注册";
+  return "暂无注册信息";
+}
+
+static void update_network (PhoshLockscreenStatus *self);
+
+static void
+registration_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (PhoshLockscreenStatus) self = data;
+  g_autoptr (GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, NULL);
+  if (G_DBUS_PROXY (source) != self->registration_proxy)
+    return;
+  self->properties_pending = FALSE;
+  g_clear_pointer (&self->registration_details, g_variant_unref);
+  if (reply)
+    self->registration_details = g_variant_get_child_value (reply, 0);
+  update_network (self);
+}
+
+static void
+contexts_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (PhoshLockscreenStatus) self = data;
+  g_autoptr (GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, NULL);
+  g_autoptr (GVariant) contexts = NULL;
+  if (G_DBUS_PROXY (source) != self->registration_proxy)
+    return;
+  self->contexts_pending = FALSE;
+  g_clear_pointer (&self->actual_apn, g_free);
+  if (reply) {
+    contexts = g_variant_get_child_value (reply, 0);
+    for (gsize i = 0; i < g_variant_n_children (contexts); i++) {
+      g_autoptr (GVariant) context = g_variant_get_child_value (contexts, i);
+      g_autoptr (GVariant) properties = g_variant_get_child_value (context, 1);
+      const char *type = NULL, *apn = NULL;
+      gboolean active = FALSE;
+      g_variant_lookup (properties, "Type", "&s", &type);
+      g_variant_lookup (properties, "Active", "b", &active);
+      if (active && !g_strcmp0 (type, "internet") &&
+          g_variant_lookup (properties, "AccessPointName", "&s", &apn)) {
+        self->actual_apn = g_strdup (apn);
+        break;
+      }
+    }
+  }
+  update_network (self);
+}
+
+static void
+refresh_registration (PhoshLockscreenStatus *self)
+{
+  if (!self->active || !self->registration_proxy)
+    return;
+  if (!self->properties_pending) {
+    self->properties_pending = TRUE;
+    g_dbus_proxy_call (self->registration_proxy, "GetProperties", NULL,
+      G_DBUS_CALL_FLAGS_NO_AUTO_START, 2000, self->cancel, registration_ready, g_object_ref (self));
+  }
+  if (!self->contexts_pending) {
+    self->contexts_pending = TRUE;
+    /* Fully qualified method reuses this proxy's bus/path with the original
+     * ConnectionManager interface. No connection is activated or changed. */
+    g_dbus_proxy_call (self->registration_proxy, "org.ofono.ConnectionManager.GetContexts", NULL,
+      G_DBUS_CALL_FLAGS_NO_AUTO_START, 2000, self->cancel, contexts_ready, g_object_ref (self));
+  }
+}
+
+static void
+registration_signal (GDBusProxy *proxy, const char *sender, const char *name,
+                      GVariant *parameters, PhoshLockscreenStatus *self)
+{
+  const char *key;
+  g_autoptr (GVariant) wrapped = NULL, value = NULL;
+  GVariantDict details;
+  if (!self->active || g_strcmp0 (name, "PropertyChanged"))
+    return;
+  g_variant_get (parameters, "(&s@v)", &key, &wrapped);
+  value = g_variant_get_variant (wrapped);
+  g_variant_dict_init (&details, self->registration_details);
+  g_variant_dict_insert_value (&details, key, value);
+  g_clear_pointer (&self->registration_details, g_variant_unref);
+  self->registration_details = g_variant_ref_sink (g_variant_dict_end (&details));
+  update_network (self);
+}
+
+typedef struct {
+  PhoshLockscreenStatus *self;
+  char *path;
+} RegistrationRequest;
+
+static void
+registration_proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  RegistrationRequest *request = data;
+  g_autoptr (PhoshLockscreenStatus) self = request->self;
+  g_autoptr (GDBusProxy) proxy = g_dbus_proxy_new_for_bus_finish (result, NULL);
+  gboolean current = !g_strcmp0 (request->path, self->registration_path);
+  g_free (request->path);
+  g_free (request);
+  if (!current)
+    return;
+  self->registration_pending = FALSE;
+  if (!proxy)
+    return;
+  g_set_object (&self->registration_proxy, proxy);
+  g_signal_connect_object (proxy, "g-signal", G_CALLBACK (registration_signal), self, 0);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (refresh_registration), self, G_CONNECT_SWAPPED);
+  refresh_registration (self);
+}
+
+static void
+ensure_registration (PhoshLockscreenStatus *self, const char *path)
+{
+  RegistrationRequest *request;
+  if (!path || !g_variant_is_object_path (path))
+    path = NULL;
+  if (!g_strcmp0 (path, self->registration_path))
+    return;
+  g_free (self->registration_path);
+  self->registration_path = g_strdup (path);
+  if (self->registration_proxy)
+    g_signal_handlers_disconnect_by_data (self->registration_proxy, self);
+  g_clear_object (&self->registration_proxy);
+  g_clear_pointer (&self->registration_details, g_variant_unref);
+  g_clear_pointer (&self->actual_apn, g_free);
+  self->registration_pending = FALSE;
+  self->properties_pending = self->contexts_pending = FALSE;
+  if (!path)
+    return;
+  request = g_new0 (RegistrationRequest, 1);
+  request->self = g_object_ref (self);
+  request->path = g_strdup (path);
+  self->registration_pending = TRUE;
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM,
+    G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START | G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+    NULL, "org.ofono", path, "org.ofono.NetworkRegistration", self->cancel,
+    registration_proxy_ready, request);
+}
+
+static void
+update_network (PhoshLockscreenStatus *self)
+{
+  const char *operator, *technology, *ssid, *iface = NULL, *address = NULL, *apn = NULL;
+  const char *status = NULL, *mode = NULL, *mcc = NULL, *mnc = NULL;
+  const char *data_status = "数据未连接";
+  g_autoptr (GVariant) details = NULL;
+  g_autofree char *registration = NULL, *signal = NULL, *wifi = NULL, *plmn = NULL, *cell = NULL;
+  NMActiveConnection *connection;
+  NMActiveConnectionState state = NM_ACTIVE_CONNECTION_STATE_UNKNOWN;
+  guint quality, cellid = 0;
+  gboolean have_cell = FALSE, radio_ready;
+
+  if (!self->active || !self->wwan || !self->wifi)
+    return;
+  operator = phosh_wwan_get_operator (self->wwan);
+  technology = phosh_wwan_get_access_tec (self->wwan);
+  quality = MIN (100, phosh_wwan_get_signal_quality (self->wwan));
+  radio_ready = phosh_wwan_is_present (self->wwan) && phosh_wwan_is_enabled (self->wwan) &&
+                phosh_wwan_has_sim (self->wwan);
+  const char *modem_path = PHOSH_IS_WWAN_MM (self->wwan) ?
+    phosh_wwan_mm_get_modem_device (PHOSH_WWAN_MM (self->wwan)) :
+    PHOSH_IS_WWAN_OFONO (self->wwan) ? phosh_wwan_ofono_get_modem_path (PHOSH_WWAN_OFONO (self->wwan)) : NULL;
+  ensure_registration (self, modem_path);
+  if (self->registration_details)
+    details = g_variant_ref (self->registration_details);
+  if (details) {
+    g_variant_lookup (details, "Status", "&s", &status);
+    g_variant_lookup (details, "Mode", "&s", &mode);
+    g_variant_lookup (details, "MobileCountryCode", "&s", &mcc);
+    g_variant_lookup (details, "MobileNetworkCode", "&s", &mnc);
+    have_cell = g_variant_lookup (details, "CellId", "u", &cellid);
+  }
+  connection = phosh_wwan_manager_get_active_connection (PHOSH_WWAN_MANAGER (self->wwan));
+  if (self->data_connection != connection) {
+    refresh_registration (self);
+    if (self->data_connection)
+      g_signal_handlers_disconnect_by_data (self->data_connection, self);
+    g_set_object (&self->data_connection, connection);
+    if (connection)
+      g_signal_connect_object (connection, "notify", G_CALLBACK (update_network), self, G_CONNECT_SWAPPED);
+  }
+  if (connection) {
+    const GPtrArray *devices = nm_active_connection_get_devices (connection);
+    NMRemoteConnection *config = nm_active_connection_get_connection (connection);
+    NMIPConfig *ip = nm_active_connection_get_ip4_config (connection);
+    state = nm_active_connection_get_state (connection);
+    if (config) {
+      NMSettingGsm *gsm = nm_connection_get_setting_gsm (NM_CONNECTION (config));
+      if (gsm) apn = nm_setting_gsm_get_apn (gsm);
+    }
+    if (state == NM_ACTIVE_CONNECTION_STATE_ACTIVATED) {
+      data_status = "数据已连接";
+      if (devices && devices->len)
+        iface = nm_device_get_ip_iface (g_ptr_array_index ((GPtrArray *) devices, 0));
+      if (ip) {
+        const GPtrArray *addresses = nm_ip_config_get_addresses (ip);
+        if (addresses && addresses->len)
+          address = nm_ip_address_get_address (g_ptr_array_index ((GPtrArray *) addresses, 0));
+      }
+    } else if (state == NM_ACTIVE_CONNECTION_STATE_ACTIVATING)
+      data_status = "数据连接中";
+    else if (state == NM_ACTIVE_CONNECTION_STATE_DEACTIVATING)
+      data_status = "正在断开数据";
+  }
+  if (g_strcmp0 (iface, self->data_iface)) {
+    g_free (self->data_iface);
+    self->data_iface = g_strdup (iface);
+    self->have_traffic = FALSE;
+    gtk_label_set_text (GTK_LABEL (self->download), "—");
+    gtk_label_set_text (GTK_LABEL (self->upload), "—");
+  }
+  if (!radio_ready) {
+    operator = !phosh_wwan_has_sim (self->wwan) ? "未插入 SIM 卡" : "蜂窝网络已关闭";
+    quality = 0;
+    technology = NULL;
+    mcc = mnc = NULL;
+    have_cell = FALSE;
+    status = "unregistered";
+  }
+  gtk_label_set_text (GTK_LABEL (self->carrier), operator && *operator ? operator : "未注册网络");
+  gtk_label_set_text (GTK_LABEL (self->technology), technology && *technology ? technology : "—");
+  signal = radio_ready ? g_strdup_printf ("信号 %u%%", quality) : g_strdup ("信号暂无数据");
+  gtk_label_set_text (GTK_LABEL (self->signal), signal);
+  gtk_level_bar_set_value (GTK_LEVEL_BAR (self->signal_bar), quality / 100.0);
+  registration = g_strdup_printf ("%s  ·  %s  ·  %s", registration_name (status),
+    !g_strcmp0 (mode, "auto") ? "自动选网" : !g_strcmp0 (mode, "manual") ? "手动选网" : "选网方式未知",
+    data_status);
+  gtk_label_set_text (GTK_LABEL (self->registration), registration);
+  plmn = mcc && mnc ? g_strconcat (mcc, " / ", mnc, NULL) : g_strdup ("暂无数据");
+  cell = have_cell ? g_strdup_printf ("%u", cellid) : g_strdup ("暂无数据");
+  gtk_label_set_text (GTK_LABEL (self->detail_values[0]), plmn);
+  gtk_label_set_text (GTK_LABEL (self->detail_values[1]), cell);
+  if ((!apn || !*apn) && self->actual_apn) apn = self->actual_apn;
+  gtk_label_set_text (GTK_LABEL (self->detail_values[2]), apn && *apn ? apn : "暂无数据");
+  gtk_label_set_text (GTK_LABEL (self->detail_values[3]), address ? address : "未分配");
+  gtk_widget_set_tooltip_text (self->detail_values[3], address);
+  ssid = phosh_wifi_manager_get_ssid (self->wifi);
+  if (phosh_wifi_manager_get_state (self->wifi) == NM_ACTIVE_CONNECTION_STATE_ACTIVATED && ssid && *ssid)
+    wifi = g_strdup_printf ("Wi-Fi  %s  ·  %u%%", ssid, phosh_wifi_manager_get_strength (self->wifi));
+  else
+    wifi = g_strdup ("Wi-Fi 未连接");
+  gtk_label_set_text (GTK_LABEL (self->wifi_label), wifi);
+  gtk_widget_set_visible (self->wifi_label, phosh_wifi_manager_get_enabled (self->wifi));
+}
+
+static gboolean
+request_sample (PhoshLockscreenStatus *self)
+{
+  g_autoptr (GTask) task = NULL;
+
+  if (!self->active)
+    return G_SOURCE_REMOVE;
+  if (self->pending)
+    return G_SOURCE_CONTINUE;
+  update_network (self);
+  update_battery (self);
+  self->pending = TRUE;
+  task = g_task_new (self, NULL, sample_ready, NULL);
+  g_task_set_task_data (task, g_strdup (self->data_iface), g_free);
+  g_task_run_in_thread (task, collect_sample);
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+update_active (PhoshLockscreenStatus *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  gboolean active = gtk_widget_get_mapped (GTK_WIDGET (self)) &&
+    phosh_shell_get_locked (shell) && !phosh_shell_get_blanked (shell);
+
+  if (active == self->active)
+    return;
+  self->active = active;
+  self->have_previous = FALSE;
+  self->have_traffic = FALSE;
+  g_debug ("Lock status sampling %s", active ? "started" : "stopped");
+  g_clear_handle_id (&self->timer, g_source_remove);
+  if (!active)
+    return;
+  set_metric (&self->cpu, "—", 0, FALSE);
+  gtk_label_set_text (GTK_LABEL (self->download), "—");
+  gtk_label_set_text (GTK_LABEL (self->upload), "—");
+  update_network (self);
+  refresh_registration (self);
+  request_sample (self);
+  self->timer = g_timeout_add_seconds (2, G_SOURCE_FUNC (request_sample), self);
+  g_source_set_name_by_id (self->timer, "[phosh] visible lockscreen status");
+}
+
+static void
+phosh_lockscreen_status_map (GtkWidget *widget)
+{
+  GTK_WIDGET_CLASS (phosh_lockscreen_status_parent_class)->map (widget);
+  update_active (PHOSH_LOCKSCREEN_STATUS (widget));
+}
+
+static void
+phosh_lockscreen_status_unmap (GtkWidget *widget)
+{
+  GTK_WIDGET_CLASS (phosh_lockscreen_status_parent_class)->unmap (widget);
+  update_active (PHOSH_LOCKSCREEN_STATUS (widget));
+}
+
+static void
+phosh_lockscreen_status_dispose (GObject *object)
+{
+  PhoshLockscreenStatus *self = PHOSH_LOCKSCREEN_STATUS (object);
+  self->active = FALSE;
+  g_clear_handle_id (&self->timer, g_source_remove);
+  g_clear_object (&self->settings);
+  if (self->cancel) g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  g_clear_object (&self->data_connection);
+  g_clear_object (&self->registration_proxy);
+  g_clear_pointer (&self->registration_details, g_variant_unref);
+  g_clear_pointer (&self->registration_path, g_free);
+  g_clear_pointer (&self->actual_apn, g_free);
+  g_clear_pointer (&self->data_iface, g_free);
+  G_OBJECT_CLASS (phosh_lockscreen_status_parent_class)->dispose (object);
+}
+
+static void
+phosh_lockscreen_status_class_init (PhoshLockscreenStatusClass *klass)
+{
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+  G_OBJECT_CLASS (klass)->dispose = phosh_lockscreen_status_dispose;
+  widget_class->map = phosh_lockscreen_status_map;
+  widget_class->unmap = phosh_lockscreen_status_unmap;
+  gtk_widget_class_set_css_name (widget_class, "phosh-lockscreen-status");
+}
+
+static void
+connect_network (PhoshLockscreenStatus *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+
+  /* The lock screen is constructed before startup creates the Wi-Fi manager. */
+  self->wwan = phosh_shell_get_wwan (shell);
+  self->wifi = phosh_shell_get_wifi_manager (shell);
+  self->battery = phosh_shell_get_battery_manager (shell);
+  g_signal_connect_object (self->battery, "notify", G_CALLBACK (update_battery), self, G_CONNECT_SWAPPED);
+  update_battery (self);
+  g_signal_connect_object (self->wwan, "notify", G_CALLBACK (update_network), self,
+                           G_CONNECT_SWAPPED);
+  g_signal_connect_object (self->wifi, "notify", G_CALLBACK (update_network), self,
+                           G_CONNECT_SWAPPED);
+  update_network (self);
+}
+
+static GtkWidget *
+label (const char *text, const char *css)
+{
+  GtkWidget *widget = gtk_label_new (text);
+  gtk_label_set_xalign (GTK_LABEL (widget), 0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (widget), css);
+  return widget;
+}
+
+static void
+style (GtkWidget *widget, const char *css)
+{
+  gtk_style_context_add_class (gtk_widget_get_style_context (widget), css);
+}
+
+static GtkWidget *
+make_metric (Metric *metric, const char *title, const char *css)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 9);
+  style (box, "status-tile");
+  style (box, css);
+  gtk_widget_set_hexpand (box, TRUE);
+  gtk_box_pack_start (GTK_BOX (box), label (title, "status-caption"), FALSE, FALSE, 0);
+  metric->value = label ("—", "status-number");
+  gtk_box_pack_start (GTK_BOX (box), metric->value, FALSE, FALSE, 0);
+  metric->bar = gtk_level_bar_new_for_interval (0, 1);
+  gtk_box_pack_start (GTK_BOX (box), metric->bar, FALSE, FALSE, 0);
+  return box;
+}
+
+static void
+phosh_lockscreen_status_init (PhoshLockscreenStatus *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  GtkWidget *network, *header, *title, *icon, *strength, *speeds, *details, *metrics;
+  const char *captions[] = {"网络代码 MCC / MNC", "当前小区", "接入点 APN", "IPv4 地址"};
+  GtkWidget *box, *value;
+
+  self->cancel = g_cancellable_new ();
+  gtk_orientable_set_orientation (GTK_ORIENTABLE (self), GTK_ORIENTATION_VERTICAL);
+  gtk_box_set_spacing (GTK_BOX (self), 12);
+  gtk_widget_set_margin_top (GTK_WIDGET (self), 20);
+  gtk_widget_set_margin_start (GTK_WIDGET (self), 20);
+  gtk_widget_set_margin_end (GTK_WIDGET (self), 20);
+  network = gtk_box_new (GTK_ORIENTATION_VERTICAL, 14);
+  style (network, "network-card");
+  gtk_box_pack_start (GTK_BOX (self), network, FALSE, FALSE, 0);
+  header = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  icon = gtk_image_new_from_icon_name ("network-cellular-symbolic", GTK_ICON_SIZE_LARGE_TOOLBAR);
+  gtk_image_set_pixel_size (GTK_IMAGE (icon), 24);
+  style (icon, "network-badge");
+  gtk_box_pack_start (GTK_BOX (header), icon, FALSE, FALSE, 0);
+  title = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  gtk_box_pack_start (GTK_BOX (title), label ("蜂窝网络", "status-caption"), FALSE, FALSE, 0);
+  self->carrier = label ("读取网络…", "network-carrier");
+  gtk_label_set_ellipsize (GTK_LABEL (self->carrier), PANGO_ELLIPSIZE_END);
+  gtk_box_pack_start (GTK_BOX (title), self->carrier, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (header), title, TRUE, TRUE, 0);
+  self->technology = label ("—", "network-technology");
+  gtk_widget_set_valign (self->technology, GTK_ALIGN_CENTER);
+  gtk_box_pack_end (GTK_BOX (header), self->technology, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (network), header, FALSE, FALSE, 0);
+  strength = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  self->signal_bar = gtk_level_bar_new_for_interval (0, 1);
+  style (self->signal_bar, "network-strength");
+  gtk_widget_set_valign (self->signal_bar, GTK_ALIGN_CENTER);
+  gtk_box_pack_start (GTK_BOX (strength), self->signal_bar, TRUE, TRUE, 0);
+  self->signal = label ("信号暂无数据", "network-signal");
+  gtk_box_pack_start (GTK_BOX (strength), self->signal, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (network), strength, FALSE, FALSE, 0);
+  self->registration = label ("正在读取连接状态", "network-registration");
+  gtk_label_set_line_wrap (GTK_LABEL (self->registration), TRUE);
+  gtk_box_pack_start (GTK_BOX (network), self->registration, FALSE, FALSE, 0);
+  speeds = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 16);
+  gtk_box_set_homogeneous (GTK_BOX (speeds), TRUE);
+  style (speeds, "network-speed-row");
+  for (guint i = 0; i < 2; i++) {
+    box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 5);
+    gtk_box_pack_start (GTK_BOX (box), label (i ? "↑  实时上传" : "↓  实时下载", "status-caption"), FALSE, FALSE, 0);
+    value = label ("—", "network-speed");
+    if (i) self->upload = value; else self->download = value;
+    gtk_box_pack_start (GTK_BOX (box), value, FALSE, FALSE, 0);
+    gtk_box_pack_start (GTK_BOX (speeds), box, TRUE, TRUE, 0);
+  }
+  gtk_box_pack_start (GTK_BOX (network), speeds, FALSE, FALSE, 0);
+  details = gtk_grid_new ();
+  gtk_grid_set_column_homogeneous (GTK_GRID (details), TRUE);
+  gtk_grid_set_column_spacing (GTK_GRID (details), 14);
+  gtk_grid_set_row_spacing (GTK_GRID (details), 14);
+  for (guint i = 0; i < G_N_ELEMENTS (captions); i++) {
+    box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 5);
+    gtk_box_pack_start (GTK_BOX (box), label (captions[i], "status-caption"), FALSE, FALSE, 0);
+    self->detail_values[i] = label ("暂无数据", "network-detail");
+    gtk_label_set_ellipsize (GTK_LABEL (self->detail_values[i]), PANGO_ELLIPSIZE_END);
+    gtk_label_set_width_chars (GTK_LABEL (self->detail_values[i]), 1);
+    gtk_box_pack_start (GTK_BOX (box), self->detail_values[i], FALSE, FALSE, 0);
+    gtk_grid_attach (GTK_GRID (details), box, i % 2, i / 2, 1, 1);
+  }
+  gtk_box_pack_start (GTK_BOX (network), details, FALSE, FALSE, 0);
+  self->wifi_label = label ("Wi-Fi 未连接", "network-registration");
+  gtk_box_pack_start (GTK_BOX (network), self->wifi_label, FALSE, FALSE, 0);
+  metrics = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  gtk_box_set_homogeneous (GTK_BOX (metrics), TRUE);
+  gtk_box_pack_start (GTK_BOX (metrics), make_metric (&self->cpu, "CPU", "cpu-tile"), TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (metrics), make_metric (&self->temperature, "温度", "temperature-tile"), TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (metrics), make_metric (&self->memory, "内存", "memory-tile"), TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (metrics), make_metric (&self->battery_metric, "电量", "battery-tile"), TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (self), metrics, FALSE, FALSE, 0);
+  gtk_widget_show_all (network);
+  gtk_widget_show_all (metrics);
+  if (phosh_shell_is_startup_finished (shell))
+    connect_network (self);
+  else
+    g_signal_connect_object (shell, "ready", G_CALLBACK (connect_network), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (shell, "notify::shell-state", G_CALLBACK (update_active), self,
+                           G_CONNECT_SWAPPED);
+  self->settings = g_settings_new ("sm.puri.phosh.lockscreen");
+  g_settings_bind (self->settings, "show-system-status", self, "visible", G_SETTINGS_BIND_GET);
+}
