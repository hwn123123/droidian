+/* Handle Back in shell-owned views before delivering a shortcut to an app.
+ * Returning from the lock keypad never unlocks or activates an application. */
+gboolean
+phosh_shell_handle_back (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  PhoshShellStateFlags state = phosh_shell_get_state (self);
+
+  if (state & PHOSH_STATE_BLANKED)
+    return TRUE;
+  /* Native prompts receive Escape via their own focused key handler. */
+  if (state & PHOSH_STATE_MODAL_SYSTEM_PROMPT)
+    return FALSE;
+  if (state & PHOSH_STATE_SETTINGS) {
+    phosh_top_panel_fold (PHOSH_TOP_PANEL (priv->top_panel));
+    return TRUE;
+  }
+  if (state & PHOSH_STATE_LOCKED) {
+    PhoshLockscreen *lockscreen = phosh_lockscreen_manager_get_lockscreen (priv->lockscreen_manager);
+    if (lockscreen)
+      phosh_lockscreen_handle_back (lockscreen);
+    return TRUE;
+  }
+  if (state & PHOSH_STATE_OVERVIEW) {
+    phosh_overview_reset (phosh_home_get_overview (PHOSH_HOME (priv->home)));
+    return TRUE;
+  }
+  return FALSE;
+}
