+phosh-lockscreen-status .network-speed { font-size: 22px; font-weight: 600; font-feature-settings: "tnum"; }
+phosh-lockscreen-status .network-detail { font-size: 17px; font-feature-settings: "tnum"; }
+phosh-lockscreen-status .status-number { font-size: 25px; font-weight: 600; font-feature-settings: "tnum"; }
