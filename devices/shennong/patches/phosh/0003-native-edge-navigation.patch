+G_DECLARE_FINAL_TYPE (PhoshEdgeNavigation, phosh_edge_navigation, PHOSH, EDGE_NAVIGATION, GObject)
+PhoshEdgeNavigation *phosh_edge_navigation_new (void);
+G_END_DECLS
