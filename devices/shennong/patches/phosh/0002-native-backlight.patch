From: Ning <hwn123123@users.noreply.github.com>
Subject: [PATCH] Use the native backlight on the primary HWC panel

Keep brightness control in Phosh and logind. Prefer a kernel backlight for
HWCOMPOSER-1 when present instead of a vendor Lights HAL which accepts but
does not apply panel brightness. Propagate real backend failures.

diff --git a/src/backlight-libdroid.c b/src/backlight-libdroid.c
index 468318d..5ebfad4 100644
--- a/src/backlight-libdroid.c
+++ b/src/backlight-libdroid.c
@@ -65,7 +65,11 @@ phosh_backlight_libdroid_set_level (PhoshBacklight      *backlight,
   g_task_set_source_tag (task, phosh_backlight_libdroid_set_level);
 
   g_debug ("Setting brightness via libdroid: %d", level);
-  droid_leds_set_backlight (self->droid_leds, level, TRUE);
+  if (!droid_leds_set_backlight (self->droid_leds, level, TRUE)) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                             "Android light service rejected the backlight change");
+    return;
+  }
 
   g_task_return_int (task, level);
 }
@@ -91,7 +95,11 @@ initable_init (GInitable *initable, GCancellable *cancel, GError **error)
 
   /* Reset backlight during startup */
   level = MAX (LIBDROID_BACKLIGHT_MIN, droid_leds_get_backlight (self->droid_leds));
-  droid_leds_set_backlight (self->droid_leds, level, FALSE);
+  if (!droid_leds_set_backlight (self->droid_leds, level, FALSE)) {
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                 "Android light service rejected the initial backlight level");
+    return FALSE;
+  }
   phosh_backlight_backend_update_level (PHOSH_BACKLIGHT (self), level);
 
   return TRUE;
diff --git a/src/backlight-sysfs.c b/src/backlight-sysfs.c
index 40a9656..87e3a69 100644
--- a/src/backlight-sysfs.c
+++ b/src/backlight-sysfs.c
@@ -101,8 +101,11 @@ phosh_backlight_sysfs_set_level (PhoshBacklight      *backlight,
   g_task_set_task_data (task, GINT_TO_POINTER (brightness), NULL);
   g_task_set_source_tag (task, phosh_backlight_sysfs_set_level);
 
-  if (!self->session_proxy)
+  if (!self->session_proxy) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED,
+                             "No logind session is available for backlight control");
     return;
+  }
 
   g_debug ("Setting brightness via logind: %d", brightness);
   phosh_dbus_login_session_call_set_brightness (self->session_proxy,
diff --git a/src/monitor/monitor.c b/src/monitor/monitor.c
index 45d61d0..6750027 100644
--- a/src/monitor/monitor.c
+++ b/src/monitor/monitor.c
@@ -88,12 +88,22 @@ output_handle_done (void             *data,
   self->wl_output_done = TRUE;
 
   if (!self->backlight && self->name) {
+    /* The primary HWC panel can expose a real kernel backlight even when
+     * the vendor Lights HAL acknowledges changes without driving the panel.
+     * Prefer the existing sysfs/logind backend when that interface is present. */
+    if (g_str_equal (self->name, "HWCOMPOSER-1")) {
+      self->backlight = PHOSH_BACKLIGHT (phosh_backlight_sysfs_new (self->name, &err));
+      if (self->backlight)
+        goto configured;
+      g_clear_error (&err);
+    }
 #ifdef PHOSH_HAVE_LIBDROID
     if (phosh_monitor_is_builtin (self)) {
       /* Try libdroid first */
       self->backlight = PHOSH_BACKLIGHT (phosh_backlight_libdroid_new (&err));
       if (self->backlight)
         goto configured;
+      g_clear_error (&err);
     }
 #endif
     self->backlight = PHOSH_BACKLIGHT (phosh_backlight_sysfs_new (self->name, &err));
