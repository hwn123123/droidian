+/* Older module-droid-hidl versions scan only the monolithic HIDL manifest
+ * and export "af" on AIDL devices whose services live in VINTF fragments.
+ * Extend that automatic detection here; an explicit --type remains honored. */
+static gboolean
+qti_manifest_file(const char* path)
+{
+    gchar* contents = NULL;
+    gboolean found = g_file_get_contents(path, &contents, NULL, NULL) &&
+        (strstr(contents, "vendor.qti.hardware.radio.am") ||
+         strstr(contents, "vendor.qti.qcril.am"));
+    g_free(contents);
+    return found;
+}
+
+static gboolean
+qti_manifest_available(void)
+{
+    const char* directory = "/vendor/etc/vintf/manifest";
+    GDir* dir;
+    const char* name;
+    gboolean found = FALSE;
+    if (qti_manifest_file("/vendor/etc/vintf/manifest.xml") ||
+        qti_manifest_file("/vendor/manifest.xml"))
+        return TRUE;
+    dir = g_dir_open(directory, 0, NULL);
+    if (!dir)
+        return FALSE;
+    while (!found && (name = g_dir_read_name(dir))) {
+        if (g_str_has_suffix(name, ".xml")) {
+            gchar* path = g_build_filename(directory, name, NULL);
+            found = qti_manifest_file(path);
+            g_free(path);
+        }
+    }
+    g_dir_close(dir);
+    return found;
+}
