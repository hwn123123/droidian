+/* Stable AIDL uses asynchronous requests (token, UTF-16 string), with a
+ * separate response interface returned by setRequestInterface(). */
+static GBinderLocalReply*
+am_client_aidl_callback(GBinderLocalObject* obj, GBinderRemoteRequest* req,
+    guint code, guint flags, int* status, void* user_data)
+{
+    AmClient* am = user_data;
+    GBinderReader reader;
+    gint32 token;
+    gchar* str;
+    const char* iface = gbinder_remote_request_interface(req);
+
+    *status = GBINDER_STATUS_OK;
+    if (g_strcmp0(iface, QCRIL_REQUEST_AIDL))
+        goto invalid;
+    if (code == 16777215 || code == 16777214) {
+        GBinderLocalReply* reply = gbinder_local_object_new_reply(obj);
+        GBinderWriter writer;
+        gbinder_local_reply_init_writer(reply, &writer);
+        gbinder_writer_append_int32(&writer, 0); /* EX_NONE */
+        if (code == 16777215)
+            gbinder_writer_append_int32(&writer, 1);
+        else
+            gbinder_writer_append_string16(&writer, QCRIL_AIDL_HASH);
+        return reply;
+    }
+    gbinder_remote_request_init_reader(req, &reader);
+    if ((code != 1 && code != 2) ||
+        !gbinder_reader_read_int32(&reader, &token))
+        goto invalid;
+    str = gbinder_reader_read_string16(&reader);
+    if (!str || !am->response) {
+        g_free(str);
+        goto invalid;
+    }
+    if (!am->app->config->dummy_mode) {
+        GBinderLocalRequest* response = gbinder_client_new_request(am->response);
+        GBinderWriter writer;
+        gchar* values = NULL;
+        gint result;
+        DBG("AIDL audio %s %s token %d: %s", am->slot,
+            code == 1 ? "query" : "set", token, str);
+        gbinder_local_request_init_writer(response, &writer);
+        gbinder_writer_append_int32(&writer, token);
+        if (code == 1) {
+            result = dbus_comms_get_parameters(am->app->dbus, str, &values);
+            gbinder_writer_append_string16(&writer, values ? values : "");
+        } else {
+            result = dbus_comms_set_parameters(am->app->dbus, str);
+            gbinder_writer_append_int32(&writer, result);
+        }
+        if (result)
+            ERR("Audio HAL %s request failed for %s", am->slot, str);
+        result = gbinder_client_transact_sync_oneway(am->response, code, response);
+        if (result)
+            ERR("AIDL audio response failed for %s: %d", am->slot, result);
+        g_free(values);
+        gbinder_local_request_unref(response);
+    }
+    g_free(str);
+    return NULL; /* oneway */
+invalid:
+    ERR("Invalid AIDL audio request %s code %u", iface, code);
+    *status = GBINDER_STATUS_FAILED;
+    return NULL;
+}
+
+static gboolean
+am_client_aidl_connect(AmClient* am)
+{
+    GBinderLocalRequest* req;
+    GBinderRemoteReply* reply;
+    GBinderReader reader;
+    GBinderRemoteObject* remote;
+    gint32 exception;
+    int status = 0;
+
+    g_free(am->fqname);
+    am->fqname = g_strconcat(QCRIL_AUDIO_AIDL, "/", am->slot, NULL);
+    remote = gbinder_servicemanager_get_service_sync(am->sm, am->fqname, &status);
+    if (!remote)
+        return FALSE;
+    am->remote = gbinder_remote_object_ref(remote);
+    am->client = gbinder_client_new(remote, QCRIL_AUDIO_AIDL);
+    am->local = gbinder_servicemanager_new_local_object(am->sm,
+        QCRIL_REQUEST_AIDL, am_client_aidl_callback, am);
+    gbinder_local_object_set_stability(am->local, GBINDER_STABILITY_VINTF);
+    req = gbinder_client_new_request(am->client);
+    gbinder_local_request_append_local_object(req, am->local);
+    reply = gbinder_client_transact_sync_reply(am->client, 1, req, &status);
+    gbinder_local_request_unref(req);
+    if (reply) {
+        gbinder_remote_reply_init_reader(reply, &reader);
+        if (gbinder_reader_read_int32(&reader, &exception) && !exception) {
+            GBinderRemoteObject* response = gbinder_reader_read_object(&reader);
+            if (response) {
+                am->response = gbinder_client_new(response, QCRIL_RESPONSE_AIDL);
+                gbinder_remote_object_unref(response);
+            }
+        }
+        gbinder_remote_reply_unref(reply);
+    }
+    if (!am->response) {
+        ERR("AIDL audio registration failed for %s: %d", am->slot, status);
+        gbinder_local_object_drop(am->local);
+        am->local = NULL;
+        gbinder_client_unref(am->client);
+        am->client = NULL;
+        gbinder_remote_object_unref(am->remote);
+        am->remote = NULL;
+        return FALSE;
+    }
+    am->death_id = gbinder_remote_object_add_death_handler(am->remote,
+        am_remote_died, am);
+    /* Equivalent to Android AudioSystem's healthy server notification. */
+    req = gbinder_client_new_request(am->client);
+    gbinder_local_request_append_int32(req, 0); /* STATUS_OK */
+    status = gbinder_client_transact_sync_oneway(am->client, 2, req);
+    gbinder_local_request_unref(req);
+    DBG("Connected AIDL audio %s (status %d)", am->fqname, status);
+    return TRUE;
+}
