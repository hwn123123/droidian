diff --git a/src/binder_signal_policy.h b/src/binder_signal_policy.h
--- /dev/null
+++ b/src/binder_signal_policy.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef BINDER_SIGNAL_POLICY_H
+#define BINDER_SIGNAL_POLICY_H
+
+#define BINDER_RSRP_THRESHOLD_COUNT 4
+
+/* A device policy, in actual dBm. Unknown/out-of-range readings stay unknown. */
+static inline int
+binder_signal_rsrp_thresholds_valid(const int* thresholds)
+{
+    int i;
+    for (i = 0; i < BINDER_RSRP_THRESHOLD_COUNT; i++) {
+        if (thresholds[i] < -140 || thresholds[i] > -44 ||
+            (i && thresholds[i] <= thresholds[i - 1])) return 0;
+    }
+    return 1;
+}
+
+static inline int
+binder_signal_rsrp_quality(int dbm, const int* thresholds)
+{
+    int level = 0;
+    if (dbm < -140 || dbm > -44) return 0;
+    while (level < BINDER_RSRP_THRESHOLD_COUNT && dbm >= thresholds[level]) level++;
+    return level * 25;
+}
+#endif
