+#include "binder_signal_policy.h"
 #include "binder_netreg.h"
 #include "binder_network.h"
 #include "binder_radio.h"
@@ -1917,6 +1918,21 @@
     }
     gutil_ints_unref(ints);

+    /* Optional device RSRP display calibration; upstream defaults stay intact. */
+    ints = binder_plugin_config_get_ints(file, group, "signalStrengthRsrpThresholds");
+    if (ints) {
+        const int* dbms = gutil_ints_get_data(ints, NULL);
+        if (gutil_ints_get_count(ints) == BINDER_RSRP_THRESHOLD_COUNT &&
+            binder_signal_rsrp_thresholds_valid(dbms)) {
+            memcpy(config->signal_strength_rsrp_thresholds, dbms,
+                sizeof(config->signal_strength_rsrp_thresholds));
+            config->signal_strength_rsrp_calibrated = TRUE;
+        } else {
+            ofono_warn("%s: ignoring invalid RSRP display thresholds", group);
+        }
+    }
+    gutil_ints_unref(ints);
+
     return slot;
 }

