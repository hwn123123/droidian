+{
+    if (m_state != FPSTATE_ENROLLING && m_state != FPSTATE_IDENTIFYING && m_state != FPSTATE_VERIFYING)
+        return SYS_EBUSY;
+    return m_androidFP.pointerDown(x, y);
+}
+
+int FPDCommunity::PointerUp()
+{
+    return m_androidFP.pointerUp();
+}
+
+int FPDCommunity::UiReady()
+{
+    return m_androidFP.uiReady();
+}
+
+int FPDCommunity::SetUiVisible(bool visible)
+{
+    if (visible && m_state != FPSTATE_ENROLLING && m_state != FPSTATE_IDENTIFYING && m_state != FPSTATE_VERIFYING)
+        return SYS_EBUSY;
+    return m_androidFP.uiVisible(visible);
+}
