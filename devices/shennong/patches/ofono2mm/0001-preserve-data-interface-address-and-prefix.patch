@@ -7 +7 @@ from dbus_next.constants import PropertyAccess
-from dbus_next import DBusError, BusType
+from dbus_next import DBusError, BusType, Message, MessageType, Variant
@@ -9,0 +10 @@ import asyncio
+import inspect
@@ -17,0 +19,50 @@ has_bus = False
+class MMMessageBus(MessageBus):
+    manager_path = '/org/freedesktop/ModemManager1'
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.pending_modems = {}
+
+    def export(self, path, interface):
+        if path.startswith(self.manager_path + '/Modem/'):
+            self.pending_modems.setdefault(path, []).append(interface)
+        else:
+            super().export(path, interface)
+
+    def send(self, message):
+        if (message.message_type == MessageType.SIGNAL and
+                message.interface == 'org.freedesktop.DBus.ObjectManager'):
+            # dbus-next emits ObjectManager signals on the child path.
+            # libmm-glib listens on the manager, and NetworkManager needs
+            # the complete modem object rather than its first interface.
+            if message.path.startswith(self.manager_path + '/Modem/'):
+                if message.member == 'InterfacesAdded':
+                    done = asyncio.get_running_loop().create_future()
+                    done.set_result(None)
+                    return done
+                message.path = self.manager_path
+        return super().send(message)
+
+    async def announce_modem(self, path):
+        # No await between making the complete object visible to
+        # GetManagedObjects and queuing its single InterfacesAdded signal.
+        # Otherwise a client can retain a proxy to a half-initialized object
+        # which a later InterfacesAdded replaces underneath it.
+        interfaces = self.pending_modems.pop(path)
+        properties = {}
+        for interface in interfaces:
+            properties[interface.name] = {}
+            for prop in interface.introspect().properties:
+                if prop.access == PropertyAccess.WRITE:
+                    continue
+                value = getattr(interface, prop.name)
+                if inspect.isawaitable(value):
+                    value = await value
+                properties[interface.name][prop.name] = Variant(prop.signature, value)
+        for interface in interfaces:
+            super().export(path, interface)
+        self.send(Message.new_signal(
+            path=self.manager_path, interface='org.freedesktop.DBus.ObjectManager',
+            member='InterfacesAdded', signature='oa{sa{sv}}',
+            body=[path, properties]))
+
