+                    "prefix": Variant('u', ipaddress.IPv4Network('0.0.0.0/' + properties['Settings'].value.get('Netmask', Variant('s', '255.255.255.255')).value).prefixlen),
@@ -375,0 +381,5 @@ class MMModemInterface(ServiceInterface):
+        if 'PinRequired' not in self.ofono_interface_props['org.ofono.SimManager']:
