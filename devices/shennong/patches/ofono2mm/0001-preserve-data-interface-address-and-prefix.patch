+            return await asyncio.wait_for(self.connect(properties), timeout=120)
+        except asyncio.TimeoutError:
+            raise DBusError('org.freedesktop.ModemManager1.Error.MobileEquipment.NetworkTimeout',
+                            'Timed out waiting for mobile data registration')
+
+    async def connect(self, properties):
+        # Simple.Connect must enable the modem as part of connecting. Merely
+        # waiting for registration deadlocks when oFono starts offline.
+        await self.mm_modem.set_enabled(True)
+        while self.mm_modem.props['State'].value < ModemManagerState.REGISTERED:
+            if self.mm_modem.props['State'].value in (ModemManagerState.FAILED,
+                                                     ModemManagerState.LOCKED):
+                raise DBusError('org.freedesktop.ModemManager1.Error.Core.WrongState',
+                                'A present, unlocked SIM is required')
+            await asyncio.sleep(1)
+
+        path = self.mm_modem.get_bearer_path_for_apn(properties['apn'].value)
+        if path is None:
+            path = await self.mm_modem.doCreateBearer(properties)
+        bearer = self.mm_modem.bearers[path]
+        bearer.update_properties(properties)
+        Logger.info('Using bearer %s for %s', path, properties['apn'].value)
+        await bearer.doConnect()
