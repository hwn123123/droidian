   gtk_widget_class_bind_template_callback (widget_class, search_entry_key_pressed_cb);
 
   gtk_widget_class_add_binding (widget_class, GDK_KEY_Left, GDK_ALT_MASK, go_back_shortcut_cb, NULL);
+  gtk_widget_class_add_binding (widget_class, GDK_KEY_Back, 0, go_back_shortcut_cb, NULL);
   gtk_widget_class_add_binding (widget_class, GDK_KEY_f, GDK_CONTROL_MASK, search_shortcut_cb, NULL);
   gtk_widget_class_add_binding (widget_class, GDK_KEY_F, GDK_CONTROL_MASK, search_shortcut_cb, NULL);
   gtk_widget_class_add_binding_action (widget_class, GDK_KEY_q, GDK_CONTROL_MASK, "window.close", NULL);
@@ -818,8 +939,18 @@ cc_window_class_init (CcWindowClass *klass)
 static void
 cc_window_init (CcWindow *self)
 {
+  GtkEventController *back_controller;
+
   gtk_widget_init_template (GTK_WIDGET (self));
 
+  /* Resolve Back before entry widgets or nested views can consume it, so
+   * one gesture dismisses only the topmost dialog or navigation level. */
+  back_controller = gtk_event_controller_key_new ();
+  gtk_event_controller_set_propagation_phase (back_controller, GTK_PHASE_CAPTURE);
+  g_signal_connect (back_controller, "key-pressed", G_CALLBACK (mobile_back_key_pressed_cb), self);
+  gtk_widget_add_controller (GTK_WIDGET (self), back_controller);
+  g_signal_connect (self, "notify::visible-dialog", G_CALLBACK (mobile_back_dialog_changed_cb), NULL);
+
   self->settings = g_settings_new ("org.gnome.Settings");
   self->previous_panels = g_queue_new ();
   self->previous_list_view = cc_panel_list_get_view (self->panel_list);
