 }
 
+/* Match ServiceStatusInfo/StatusForAccessTech.writeToParcel in the stock
+ * IMS client. Enable voice and SMS together on the cellular IMS transport. */
+static
+void
+qti_radio_ext_aidl_set_service_status_args(
+    GBinderWriter* writer,
+    va_list va)
+{
+    gboolean enabled = va_arg(va, int);
+    const gint32 status = enabled ? QTI_RADIO_STATUS_ENABLED : QTI_RADIO_STATUS_DISABLED;
+    const gint32 types[] = { QTI_RADIO_CALL_TYPE_VOICE, QTI_RADIO_CALL_TYPE_SMS };
+    guint i;
+
+    gbinder_writer_append_int32(writer, G_N_ELEMENTS(types));
+    for (i = 0; i < G_N_ELEMENTS(types); i++) {
+        gint32 service_start, access_start;
+        gbinder_writer_append_int32(writer, 1);
+        service_start = gbinder_writer_bytes_written(writer);
+        gbinder_writer_append_int32(writer, 0);
+        gbinder_writer_append_bool(writer, TRUE);
+        gbinder_writer_append_int32(writer, types[i]);
+        gbinder_writer_append_int32(writer, status);
+        gbinder_writer_append_int32(writer, 0);
+        gbinder_writer_append_int32(writer, 1); /* accTechStatus array */
+        gbinder_writer_append_int32(writer, 1);
+        access_start = gbinder_writer_bytes_written(writer);
+        gbinder_writer_append_int32(writer, 0);
+        gbinder_writer_append_int32(writer, QTI_RADIO_TECH_LTE);
+        gbinder_writer_append_int32(writer, status);
+        gbinder_writer_append_int32(writer, 0);
+        gbinder_writer_append_bool(writer, FALSE); /* no registration override */
+        gbinder_writer_append_int32(writer, 0); /* null RegistrationInfo */
+        gbinder_writer_overwrite_int32(writer, access_start,
+            gbinder_writer_bytes_written(writer) - access_start);
+        gbinder_writer_append_int32(writer, QTI_RADIO_RTT_MODE_DISABLED);
+        gbinder_writer_overwrite_int32(writer, service_start,
+            gbinder_writer_bytes_written(writer) - service_start);
+    }
+}
