# First display milestone: add only facilities needed by the privileged
# Android HAL container and the standard Phosh session.
# SysV IPC, user namespaces and extra controllers remain at stock settings
# while checking the binary vendor drivers' KMI.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
# Honor the Linux/Halium host policy choice on B without changing Android A.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
# Android Bluetooth is bridged into BlueZ through the native virtual HCI.
CONFIG_BT_HCIVHCI=m
