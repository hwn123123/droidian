# Add to the matching Android 14 GKI configuration. Keep the vendor KMI.
# The running stock 6.1.138 config lacks the container prerequisites below.
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y

# Keep driver signatures and the existing boot command line unchanged here.
# No built-in initramfs: init_boot_b and the existing REC dispatcher own boot.
