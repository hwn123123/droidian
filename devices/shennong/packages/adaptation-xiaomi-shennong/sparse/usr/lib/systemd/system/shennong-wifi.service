[Unit]
Description=Stock Qualcomm WLAN hardware for the native Linux network stack
Requires=shennong-vendor.service
Wants=shennong-adsp.service
After=shennong-vendor.service shennong-adsp.service lxc@android.service
Before=wpa_supplicant.service

[Service]
Type=oneshot
ExecStartPre=/usr/libexec/shennong-qup-check
ExecStartPre=/usr/bin/test -d /vendor/firmware_mnt/image/kiwi
ExecStartPre=/usr/bin/test -s /usr/lib/firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini
ExecStart=/usr/sbin/modprobe qca_cld3_kiwi_v2
ExecStart=/usr/bin/tee /sys/kernel/cnss/fs_ready
StandardInput=data
StandardInputText=1
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
