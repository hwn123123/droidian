[Unit]
Description=Xiaomi 14 Pro USB network and SSH management link
Requires=lxc@android.service
After=lxc@android.service sys-kernel-config.mount NetworkManager.service
Wants=sys-kernel-config.mount

[Service]
Type=oneshot
ExecStart=/usr/libexec/shennong-usb-network
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
