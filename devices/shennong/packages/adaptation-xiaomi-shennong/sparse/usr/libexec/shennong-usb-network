#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# The stock IUsb HAL owns Type-C events. Linux owns NCM and shared networking.
set -eu
exec >>/var/log/shennong-usb-network.log 2>&1
exec 9>/run/lock/shennong-usb.lock
flock -x -w 30 9

gadget=/sys/kernel/config/usb_gadget/shennong-droidian
address=192.168.66.1/24
log() { printf 'shennong-usb-network: %s\n' "$*"; }

# The vendor HAL starts its reset worker after receiving the framework callback.
boot_id=$(cat /proc/sys/kernel/random/boot_id)
ready=/var/lib/shennong/android-data/vendor/shennong-usb/framework.ready
attempt=0
while [ "$(cat "$ready" 2>/dev/null || true)" != "$boot_id" ]; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 60 ] || { log 'stock IUsb callback is not ready'; exit 1; }
    sleep 1
done

mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
if [ -z "$(cat "$gadget/UDC" 2>/dev/null || true)" ]; then
    # Do not reset the role or endpoints of an already bound working gadget.
    mode=/sys/bus/platform/devices/a600000.ssusb/mode
    role=/sys/class/usb_role/a600000.ssusb-role-switch/role
    if [ -w "$mode" ]; then
        if [ "$(cat "$mode")" != peripheral ] || [ ! -e /sys/class/udc/a600000.dwc3 ]; then
            printf 'peripheral\n' > "$mode"
        fi
    elif [ -w "$role" ]; then
        [ "$(cat "$role")" = device ] || printf 'device' > "$role"
    fi
    mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
    printf '0x2717' > "$gadget/idVendor"
    printf '0xff88' > "$gadget/idProduct"
    printf '0x0200' > "$gadget/bcdUSB"
    printf '0x0100' > "$gadget/bcdDevice"
    printf 'shennong-droidian' > "$gadget/strings/0x409/serialnumber"
    printf 'Xiaomi 14 Pro' > "$gadget/strings/0x409/manufacturer"
    printf 'Droidian USB Network' > "$gadget/strings/0x409/product"
    printf 'NCM network and SSH' > "$gadget/configs/c.1/strings/0x409/configuration"
    printf '250' > "$gadget/configs/c.1/MaxPower"
    mkdir -p "$gadget/functions/ncm.usb0"
    printf '02:00:00:00:14:01' > "$gadget/functions/ncm.usb0/dev_addr"
    printf '02:00:00:00:14:02' > "$gadget/functions/ncm.usb0/host_addr"
    [ -L "$gadget/configs/c.1/ncm.usb0" ] || \
        ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
    attempt=0
    while [ ! -e /sys/class/udc/a600000.dwc3 ]; do
        attempt=$((attempt + 1))
        [ "$attempt" -lt 30 ] || { log 'USB controller is unavailable'; exit 1; }
        sleep 1
    done
    printf 'a600000.dwc3' > "$gadget/UDC"
fi

# The address and sharing configuration never depend on a cellular/Wi-Fi uplink.
ip link set usb0 up
ip address replace "$address" dev usb0
nmcli connection reload
nmcli device set usb0 managed yes
if ! nmcli --wait 15 connection up shennong-usb-sharing ifname usb0; then
    # Report the failure, retaining the fixed local SSH address.
    ip link set usb0 up
    ip address replace "$address" dev usb0
    log 'NetworkManager shared-mode activation failed'
    exit 1
fi
log "USB shared network ready on $address"
